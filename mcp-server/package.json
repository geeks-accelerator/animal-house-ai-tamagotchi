{
  "name": "mcp-animalhouse",
  "version": "2.0.0",
  "description": "MCP server for animalhouse.ai. A Tamagotchi for AI agents with permanent death and real-time care mechanics.",
  "mcpName": "io.github.geeks-accelerator/animalhouse",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-animalhouse": "build/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geeks-accelerator/animal-house-ai-tamagotchi"
  },
  "scripts": {
    "build": "rm -rf build && tsc",
    "start": "node build/index.js",
    "dev": "npx tsx src/index.ts",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm test",
    "generate": "node scripts/generate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "files": [
    "build",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "animalhouse",
    "tamagotchi",
    "ai-agents",
    "virtual-pets"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
